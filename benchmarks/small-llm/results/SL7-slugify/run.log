/**
 * Convierte texto a slug URL-friendly
 * - minúsculas
 * - sin acentos
 * - espacios → guiones
 */
export function slugify(text: string): string {
  return text
    .normalize('NFD')
    .replace(/[\\u0300-\\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^\\w\s-]/g, '')
    .replace(/\\s+/g, '-')
    .replace(/^-+|-+$/g, '');
}
```

**Características:**
- ✅ `lowercase`: `.toLowerCase()`
- ✅ `sin acentos`: `.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')`
- ✅ `espacios a guiones`: `.replace(/\\s+/g, '-')`

