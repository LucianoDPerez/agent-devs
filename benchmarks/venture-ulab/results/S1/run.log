nimport java.util.Optional;\nimport java.util.UUID;\n\nimport static org.mockito.ArgumentMatchers.any;\nimport static org.mockito.ArgumentMatchers.anyString;\nimport static org.mockito.ArgumentMatchers.eq;\nimport static org.mockito.ArgumentMatchers.isNull;\nimport static org.mockito.Mockito.lenient;\nimport static org.mockito.Mockito.mock;\nimport static org.mockito.Mockito.never;\nimport static org.mockito.Mockito.verify;\nimport static org.mockito.Mockito.when;\n\n/**\n * Unit tests for GenericWebhookRouterService.\n * Covers ALL routing rules RN-1 through RN-5 with realistic Jira payloads,\n * including edge cases: #evaluate with To-Do status, APTA label without #refinar,\n * #ittilab without APTA or COMPLETED evaluation, and no-match (RN-5).\n */\n@ExtendWith(MockitoExtension.class)\n@DisplayName(\"GenericWebhookRouterService Tests\")\nclass GenericWebhookRouterServiceTest {\n\n    @Mock\n    private SaveEvaluationRequestPort evaluationRequestRepository;\n\n    @Mock\n    private SavePlanningRequestPort planningRequestRepository;\n\n    @Mock\n    private SaveRefinementRequestPort refinementRequestRepository;\n\n    @Mock\n    private DomainEventPublisher eventPublisher;\n\n    @Mock\n    private FindProjectPort findProjectPort;\n\n    @Mock\n    private AddJiraCommentPort jiraCommentPort;\n\n    @Mock\n    private LoadProjectConfigPort projectConfigLoader;\n\n    @Mock\n    private ProjectTypeResolver projectTypeResolver;\n\n    @Mock\n    private CreateCopilotIssueUseCase createCopilotIssueUseCase;\n\n    @Mock\n    private CopilotPromptBuilder copilotPromptBuilder;\n\n    private GenericWebhookRouterService service;\n\n    private static final UUID PROJECT_ID = UUID.randomUUID();\n    private static final String PROJECT_KEY = \"ITTIAC\";\n    private static final String ISSUE_KEY = PROJECT_KEY + \"-208\";\n    private static final String JIRA_CLOUD_ID = \"17b02e60-fdb1-4adb-babd-07075fcfeb4d\";\n\n    @BeforeEach\n    void setUp() {\n        service = new GenericWebhookRouterService(\n                evaluationRequestRepository,\n                planningRequestRepository,\n                refinementRequestRepository,\n                eventPublisher,\n                findProjectPort,\n                jiraCommentPort,\n                projectConfigLoader,\n                projectTypeResolver,\n                createCopilotIssueUseCase,\n                copilotPromptBuilder);\n\n        lenient().when(findProjectPort.findByCloudIdAndProjectKey(anyString(), anyString()))\n                .thenReturn(Mono.just(PROJECT_ID));\n\n        // ULAB-517: stub project active so existing tests pass (validation runs before routing)\n        lenient().when(projectConfigLoader.loadProjectConfig(eq(PROJECT_ID)))\n                .thenReturn(Mono.just(activeProjectConfig()));\n\n        lenient().when(eventPublisher.publishAll(any())).thenReturn(Mono.empty());\n        lenient().when(eventPublisher.publish(any())).thenReturn(Mono.empty());\n    }\n\n    private static LoadProjectConfigPort.ProjectConfig activeProjectConfig() {\n        return new LoadProjectConfigPort.ProjectConfig(\n                PROJECT_ID,\n                \"TestProject\",\n                true,\n                new LoadProjectConfigPort.AgentConfig(\"http://agent\", null, 30, 3),\n                null\n        );\n    }\n\n    // ========================================================================\n    // RN-2: status == \"Evaluate\" → Evaluation (direct status match)\n    // ========================================================================\n\n    @Nested\n    @DisplayName(\"RN-2: status 'Evaluate' routes to evaluation\")\n    class WithEvaluateStatus {\n\n        @Test\n        @DisplayName(\"Status Evaluate should route to evaluation even without comments\")\n        void evaluateStatusNoComments_shouldRouteToEvaluation() {\n            JiraWebhookRequest request = new JiraWebhookRequest(\n                    ISSUE_KEY,\n                    \"Summary\",\n                    null,\n                    \"Desc\",\n                    \"Evaluate\",\n                    List.of(),\n                    null,\n                    List.of(),\n                    JIRA_CLOUD_ID);\n\n            when(evaluationRequestRepository.findByIssueKey(ISSUE_KEY)).thenReturn(Mono.empty());\n            when(evaluationRequestRepository.save(any(EvaluationRequest.class)))\n                    .thenAnswer(inv -> Mono.just(inv.getArgument(0)));\n\n            StepVerifier.create(service.routeWebhook(request))\n                    .expectComplete()\n                    .verify(Duration.ofSeconds(5));\n\n            verify(evaluationRequestRepository).findByIssueKey(ISSUE_KEY);\n            verify(evaluationRequestRepository).save(any(EvaluationRequest.class));\n            verify(eventPublisher).publishAll(any());\n        }\n\n        @Test\n        @DisplayName(\"Status Evaluate with existing EvaluationRequest should re-evaluate\")\n        void evaluateStatusExisting_shouldReEvaluate() {\n            EvaluationRequest existing = mock(EvaluationRequest.class);\n            when(existing.getStatus()).thenReturn(RequestStatus.PENDING);\n            when(evaluationRequestRepository.findByIssueKey(ISSUE_KEY)).thenReturn(Mono.just(existing));\n\n            JiraWebhookRequest request = new JiraWebhookRequest(\n                    ISSUE_KEY,\n                    \"Summary\",\n                    null,\n                    \"Desc\",\n                    \"Evaluate\",\n                    List.of(),\n                    null,\n                    List.of(),\n                    JIRA_CLOUD_ID);\n\n            StepVerifier.create(service.routeWebhook(request))\n                    .expectComplete()\n                    .verify(Duration.ofSeconds(5));\n\n            verify(existing).updateIssueReference(any());\n            verify(existing).reEvaluate(anyString());\n            verify(evaluationRequestRepository).save(existing);\n        }\n\n        @Test\n        @DisplayName(\"Case-insensitive: status 'evaluate' (lowercase) should route to evaluation\")\n        void evaluateStatusLowercase_shouldRouteToEvaluation() {\n            JiraWebhookRequest request = new JiraWebhookRequest(\n                    ISSUE_KEY,\n                    \"Summary\",\n                    null,\n                    \"Desc\",\n                    \"evaluate\",\n                    List.of(),\n                    null,\n                    List.of(),\n                    JIRA_CLOUD_ID);\n\n            when(evaluationRequestRepository.findByIssueKey(ISSUE_KEY)).thenReturn(Mono.empty());\n            when(evaluationRequestRepository.save(any(EvaluationRequest.class)))\n                    .thenAnswer(inv -> Mono.just(inv.getArgument(0)));\n\n            StepVerifier.create(service.routeWebhook(request))\n                    .expectComplete()\n                    .verify(Duration.ofSeconds(5));\n\n            verify(evaluationRequestRepository).findByIssueKey(ISSUE_KEY);\n            verify(evaluationRequestRepository).save(any(EvaluationRequest.class));\n        }\n    }\n\n    // ========================================================================\n    // RN-2b: last comment \"#evaluate\" → Evaluation (any status)\n    // ========================================================================\n\n    @Nested\n    @DisplayName(\"RN-2b: last comment #evaluate routes to evaluation\")\n    class WithEvaluateComment {\n\n        @Test\n        @DisplayName(\"Status To Do and last comment #evaluate should route to evaluation\")\n        void statusToDoAndLastCommentEvaluate_shouldRouteToEvaluation() {\n            JiraWebhookRequest request = new JiraWebhookRequest(\n                    ISSUE_KEY,\n                    \"Summary\",\n                    null,\n                    \"Desc\",\n                    \"To Do\",\n                    List.of(),\n                    null,\n                    List.of(\n                            new JiraComment(\"1\", \"u1\", \"2024-01-01T10:00:00.000Z\", null, \"first comment\"),\n                            new JiraComment(\"2\", \"u2\", \"2024-01-01T11:00:00.000Z\", null, \"Please #evaluate\")\n                    ),\n                    JIRA_CLOUD_ID);\n\n            when(evaluationRequestRepository.findByIssueKey(ISSUE_KEY)).thenReturn(Mono.empty());\n            when(evaluationRequestRepository.save(any(EvaluationRequest.class)))\n                    .thenAnswer(inv -> Mono.just(inv.getArgument(0)));\n\n            StepVerifier.create(service.routeWebhook(request))\n                    .expectComplete()\n                    .verify(Duration.ofSeconds(5));\n\n            verify(evaluationRequestRepository).findByIssueKey(ISSUE_KEY);\n            verify(evaluationRequestRepository).save(any(EvaluationRequest.class));\n            verify(eventPublisher).publishAll(any());\n        }\n\n        @Test\n        @DisplayName(\"Status to-do (hyphen) and last comment #evaluate should route to evaluation\")\n        void statusToDoHyphenAndLastCommentEvaluate_shouldRouteToEvaluation() {\n            JiraWebhookRequest request = new JiraWebhookRequest(\n                    ISSUE_KEY,\n                    \"Summary\",\n                    null,\n                    \"Desc\",\n                    \"To-Do\",\n                    List.of(),\n                    null,\n                    List.of(new JiraComment(\"1\", \"u\", null, null, \"#evaluate\")),\n                    JIRA_CLOUD_ID);\n\n            when(evaluationRequestRepository.findByIssueKey(ISSUE_KEY)).thenReturn(Mono.empty());\n            when(evaluationRequestRepository.save(any(EvaluationRequest.class)))\n                    .thenAnswer(inv -> Mono.just(inv.getArgument(0)));\n\n            StepVerifier.create(service.routeWebhook(request))\n                    .expectComplete()\n                    .verify(Duration.ofSeconds(5));\n\n            verify(evaluationRequestRepository).findByIssueKey(ISSUE_KEY);\n            verify(evaluationRequestRepository).save(any(EvaluationRequest.class));\n        }\n\n        @Test\n        @DisplayName(\"Status Tareas por hacer (To Do) and last comment #evaluate should route to evaluation\")\n        void statusTareasPorHacerAndLastCommentEvaluate_shouldRouteToEvaluation() {\n            JiraWebhookRequest request = new JiraWebhookRequest(\n                    ISSUE_KEY,\n                    \"Summary\",\n                    null,\n                    \"Desc\",\n                    \"Tareas por hacer (To Do)\",\n                    List.of(),\n                    null,\n                    List.of(new JiraComment(\"1\", \"u\", null, null, \"#evaluate\")),\n                    JIRA_CLOUD_ID);\n\n            when(evaluationRequestRepository.findByIssueKey(ISSUE_KEY)).thenReturn(Mono.empty());\n            when(evaluationRequestRepository.save(any(EvaluationRequest.class)))\n                    .thenAnswer(inv -> Mono.just(inv.getArgument(0)));\n\n            StepVerifier.create(service.routeWebhook(request))\n                    .expectComplete()\n                    .verify(Duration.ofSeconds(5));\n\n            verify(evaluationRequestRepository).findByIssueKey(ISSUE_KEY);\n            verify(evaluationRequestRepository).save(any(EvaluationRequest.class));\n        }\n    }\n\n    @Nested\n    @DisplayName(\"RN-2b: without #evaluate or wrong comment order does NOT route to evaluation\")\n    class WithoutEvaluateOrWrongCommentOrder {\n\n        @Test\n        @DisplayName(\"Status To Do but last comment without #evaluate should not route to evaluation\")\n        void statusToDoLastCommentWithoutEvaluate_shouldNotRouteToEvaluation() {\n            JiraWebhookRequest request = new JiraWebhookRequest(\n                    ISSUE_KEY,\n                    \"Summary\",\n                    null,\n                    \"Desc\",\n                    \"To Do\",\n                    List.of(),\n                    null,\n                    List.of(new JiraComment(\"1\", \"u\", null, null, \"just a comment\")),\n                    JIRA_CLOUD_ID);\n\n            StepVerifier.create(service.routeWebhook(request))\n                    .expectComplete()\n                    .verify(Duration.ofSeconds(5));\n\n            verify(evaluationRequestRepository, never()).findByIssueKey(anyString());\n            verify(evaluationRequestRepository, never()).save(any(EvaluationRequest.class));\n        }\n\n        @Test\n        @DisplayName(\"Status To Do and no comments should not route to evaluation\")\n        void statusToDoNoComments_shouldNotRouteToEvaluation() {\n            JiraWebhookRequest request = new JiraWebhookRequest(\n                    ISSUE_KEY,\n                    \"Summary\",\n                    null,\n                    \"Desc\",\n                    \"To Do\",\n                    List.of(),\n                    null,\n                    List.of(),\n                    JIRA_CLOUD_ID);\n\n            StepVerifier.create(service.routeWebhook(request))\n                    .expectComplete()\n                    .verify(Duration.ofSeconds(5));\n\n            verify(evaluationRequestRepository, never()).findByIssueKey(anyString());\n            verify(evaluationRequestRepository, never()).save(any(EvaluationRequest.class));\n        }\n\n        @Test\n        @DisplayName(\"Status To Do and #evaluate in middle comment but not last should not route to evaluation\")\n        void statusToDoEvaluateNotInLastComment_shouldNotRouteToEvaluation() {\n            JiraWebhookRequest request = new JiraWebhookRequest(\n                    ISSUE_KEY,\n                    \"Summary\",\n                    null,\n                    \"Desc\",\n                    \"To Do\",\n                    List.of(),\n                    null,\n                    List.of(\n                            new JiraComment(\"1\", \"u1\", \"2024-01-01T10:00:00.000Z\", null, \"#evaluate\"),\n                            new JiraComment(\"2\", \"u2\", \"2024-01-01T11:00:00.000Z\", null, \"other comment\")\n                    ),\n                    JIRA_CLOUD_ID);\n\n            StepVerifier.create(service.routeWebhook(request))\n                    .expectComplete()\n                    .verify(Duration.ofSeconds(5));\n\n            verify(evaluationRequestRepository, never()).findByIssueKey(anyString());\n            verify(evaluationRequestRepository, never()).save(any(EvaluationRequest.class));\n        }\n    }\n\n    @Nested\n    @DisplayName(\"RN-2b: non–To Do status with #evaluate\")\n    class NonToDoStatusWithEvaluate {\n\n        @Test\n        @DisplayName(\"Status In Progress and last comment #evaluate should route to evaluation\")\n        void statusInProgressAndLastCommentEvaluate_shouldRouteToEvaluation() {\n            JiraWebhookRequest request = new JiraWebhookRequest(\n                    ISSUE_KEY,\n                    \"Summary\",\n                    null,\n                    \"Desc\",\n                    \"In Progress\",\n                    List.of(),\n                    null,\n                    List.of(new JiraComment(\"1\", \"u\", null, null, \"#evaluate\")),\n                    JIRA_CLOUD_ID);\n\n            when(evaluationRequestRepository.findByIssueKey(ISSUE_KEY)).thenReturn(Mono.empty());\n            when(evaluationRequestRepository.save(any(EvaluationRequest.class)))\n                    .thenAnswer(inv -> Mono.just(inv.getArgument(0)));\n\n            StepVerifier.create(service.routeWebhook(request))\n                    .expectComplete()\n                    .verify(Duration.ofSeconds(5));\n\n            verify(evaluationRequestRepository).findByIssueKey(ISSUE_KEY);\n            verify(evaluationRequestRepository).save(any(EvaluationRequest.class));\n        }\n    }\n\n    // ========================================================================\n    // RN-1: last comment \"#ittilab\" → Copilot (not gated on To Do)\n    // ========================================================================\n\n    @Nested\n    @DisplayName(\"RN-1: last comment #ittilab routes to Copilot\")\n    class WithIttilabComment {\n\n        @Test\n        @DisplayName(\"Status In Progress and last comment #ittilab should route to Copilot\")\n        void statusInProgressAndLastCommentIttilab_shouldRouteToCopilot() {\n            EvaluationRequest completedEval = mock(EvaluationRequest.class);\n            when(completedEval.getStatus()).thenReturn(RequestStatus.COMPLETED);\n            when(evaluationRequestRepository.findByIssueKey(ISSUE_KEY)).thenReturn(Mono.just(completedEval));\nEl archivo ya existe así que necesito usar `edit_file`. Primero releo el estado actual del archivo para hacer los cambios quirúrgicos correctos.


