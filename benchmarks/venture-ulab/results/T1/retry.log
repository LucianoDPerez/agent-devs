.LoggerFactory.getLogger(\n                        CorrelationIdWebFilter.class);\n        ListAppender<LogEvent> appender = new ListAppender<>();\n        appender.setContext(logger.getContext());\n        appender.startLogging();\n        appender.start();\n        logger.addAppender(appender);\n\n        try {\n            String inbound = \"trace-456\";\n            MockServerWebExchange exchange = MockServerWebExchange.from(\n                    MockServerHttpRequest.post(\"/api/v1/resource\")\n                            .header(CorrelationIdWebFilter.HEADER_NAME, inbound));\n\n            WebFilterChain chain = exch -> Mono.empty();\n            filter.filter(exchange, chain).block();\n\n            // Assert: verify the log event contains method+path+status+durationMs\n            ListAppender<LogEvent> appender2 = new ListAppender<>();\n            appender2.setContext(logger.getContext());\n            appender2.startLogging();\n            appender2.start();\n            logger.addAppender(appender2);\n\n            // Re-run to capture a fresh log entry in the second appender\n            MockServerWebExchange exchange2 = MockServerWebExchange.from(\n                    MockServerHttpRequest.put(\"/api/v1/resource\")\n                            .header(CorrelationIdWebFilter.HEADER_NAME, \"trace-789\"));\n            WebFilterChain chain2 = exch -> Mono.empty();\n            filter.filter(exchange2, chain2).block();\n\n            java.util.List<LogEvent> logs = appender2.getList();\n            assertThat(logs).isNotEmpty();\n            LogEvent lastLog = logs.get(logs.size() - 1);\n            String msg = lastLog.getMessage();\n            assertThat(msg).contains(\"PUT\");\n            assertThat(msg).contains(\"/api/v1/resource\");\n            assertThat(msg).contains(\"200\"); // MockServerWebExchange defaults to 200\n            assertThat(msg).matches(\".*\\d+ms$\"); // duration in ms\n\n        } finally {\n            logger.detachAndStopAllAppenders();\n        }\n    }\n}"}
