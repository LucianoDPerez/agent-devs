  🔧 write_file{"path":"/Users/luciano.perez/itti/venture-api-ulab/src/test/java/py/com/itti/ms/base/common/config/CorrelationIdWebFilterTest.java","content":"package py.com.itti.ms.base.common.config;\n\nimport ch.qos.logback.classic.Level;\nimport ch.qos.logback.classic.spi.LogEvent;\nimport ch.qos.logback.core.read.ListAppender;\nimport org.junit.jupiter.api.AfterEach;\nimport org.junit.jupiter.api.DisplayName;\nimport org.junit.jupiter.api.Test;\nimport org.slf4j.MDC;\nimport org.springframework.http.HttpHeaders;\nimport org.springframework.mock.http.server.reactive.MockServerHttpRequest;\nimport org.springframework.mock.web.server.MockServerWebExchange;\nimport org.springframework.web.server.WebFilterChain;\nimport reactor.core.publisher.Mono;\n\nimport java.util.concurrent.atomic.AtomicReference;\n\nimport static org.assertj.core.api.Assertions.assertThat;\n\n@DisplayName(\"CorrelationIdWebFilter\")\nclass CorrelationIdWebFilterTest {\n\n    private final CorrelationIdWebFilter filter = new CorrelationIdWebFilter();\n\n    @Test\n    @DisplayName(\"generates X-Correlation-Id when missing and propagates to attributes, header, and MDC\")\n    void generatesWhenMissing() {\n        MockServerWebExchange exchange = MockServerWebExchange.from(\n                MockServerHttpRequest.get(\"/api/v1/foo\"));\n\n        AtomicReference<String> mdcDuringChain = new AtomicReference<>();\n        WebFilterChain chain = exch -> Mono.fromRunnable(\n                () -> mdcDuringChain.set(MDC.get(CorrelationIdWebFilter.MDC_KEY)));\n\n        filter.filter(exchange, chain).block();\n\n        String fromAttribute = (String) exchange.getAttribute(CorrelationIdWebFilter.ATTRIBUTE_KEY);\n        String fromHeader = exchange.getResponse().getHeaders().getFirst(CorrelationIdWebFilter.HEADER_NAME);\n\n        assertThat(fromAttribute).isNotBlank();\n        assertThat(fromHeader).isEqualTo(fromAttribute);\n        assertThat(mdcDuringChain.get()).isEqualTo(fromAttribute);\n        // After completion the filter MUST clean up MDC to avoid leaking across requests\n        assertThat(MDC.get(CorrelationIdWebFilter.MDC_KEY)).isNull();\n    }\n\n    @Test\n    @DisplayName(\"echoes back the inbound X-Correlation-Id when provided\")\n    void echoesInbound() {\n        String inbound = \"trace-123-from-client\";\n        MockServerWebExchange exchange = MockServerWebExchange.from(\n                MockServerHttpRequest.get(\"/api/v1/foo\")\n                        .header(CorrelationIdWebFilter.HEADER_NAME, inbound));\n\n        WebFilterChain chain = exch -> Mono.empty();\n        filter.filter(exchange, chain).block();\n\n        assertThat((String) exchange.getAttribute(CorrelationIdWebFilter.ATTRIBUTE_KEY)).isEqualTo(inbound);\n        assertThat(exchange.getResponse().getHeaders().getFirst(CorrelationIdWebFilter.HEADER_NAME))\n                .isEqualTo(inbound);\n    }\n\n    @Test\n    @DisplayName(\"treats blank inbound header as missing and generates a fresh id\")\n    void blankHeaderGeneratesNew() {\n        MockServerWebExchange exchange = MockServerWebExchange.from(\n                MockServerHttpRequest.get(\"/api/v1/foo\")\n                        .header(HttpHeaders.ACCEPT, \"application/json\"));\n\n        WebFilterChain chain = exch -> Mono.empty();\n        filter.filter(exchange, chain).block();\n\n        String fromAttribute = (String) exchange.getAttribute(CorrelationIdWebFilter.ATTRIBUTE_KEY);\n        assertThat(fromAttribute).isNotBlank();\n        assertThat(exchange.getResponse().getHeaders().getFirst(CorrelationIdWebFilter.HEADER_NAME))\n                .isEqualTo(fromAttribute);\n    }\n\n    @Test\n    @DisplayName(\"logs method, path, status and duration on chain completion\")\n    void logsRequestMetrics() {\n        ch.qos.logback.classic.Logger logger =\n                (ch.qos.logback.classic.Logger) org.slf4j.LoggerFactory.getLogger(\n                        CorrelationIdWebFilter.class);\n        ListAppender<LogEvent> appender = new ListAppender<>();\n        appender.setContext(logger.getContext());\n        appender.startLogging();\n        appender.start();\n        logger.addAppender(appender);\n\n        try {\n            MockServerWebExchange exchange = MockServerWebExchange.from(\n                    MockServerHttpRequest.put(\"/api/v1/resource\")\n                            .header(CorrelationIdWebFilter.HEADER_NAME, \"trace-789\"));\n            WebFilterChain chain = exch -> Mono.empty();\n            filter.filter(exchange, chain).block();\n\n            java.util.List<LogEvent> logList = appender.getList();\n            assertThat(logList).isNotEmpty();\n            LogEvent lastLog = logList.get(logList.size() - 1);\n            String msg = lastLog.getMessage();\n            assertThat(msg).contains(\"PUT\");\n            assertThat(msg).contains(\"/api/v1/resource\");\n            assertThat(msg).contains(\"200\"); // MockServerWebExchange defaults to 200\n            assertThat(msg).matches(\".*\\d+ms$\");\n        } finally {\n            logger.detachAndStopAllAppenders();\n        }\n    }\n}\n"}
