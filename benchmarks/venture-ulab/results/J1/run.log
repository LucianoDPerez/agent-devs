 should return 200 with empty name\")\n    void shouldReturnPingWithEmptyName() {\n        String name = \"\";\n        String expectedMessage = \"PONG \";\n        when(baseService.ping(name)).thenReturn(expectedMessage);\n\n        webTestClient.get()\n                .uri(\"/v1/ping/{name}\", name)\n                .exchange()\n                .expectStatus().isOk()\n                .expectBody()\n                .jsonPath(\"$.message\").isEqualTo(expectedMessage);\n    }\n\n    @Test\n    @DisplayName(\"GET /v1/ping/{name} should return 200 with special characters\")\n    void shouldReturnPingWithSpecialCharacters() {\n        String name = \"test-user_123\";\n        String expectedMessage = \"PONG test-user_123\";\n        when(baseService.ping(name)).thenReturn(expectedMessage);\n\n        webTestClient.get()\n                .uri(\"/v1/ping/{name}\", name)\n                .exchange()\n                .expectStatus().isOk()\n                .expectBody()\n                .jsonPath(\"$.message\").isEqualTo(expectedMessage);\n    }\n}\n"}El archivo ya existe. Voy a leerlo y luego editarlo.


