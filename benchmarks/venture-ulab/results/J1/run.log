;\nimport org.springframework.test.web.reactive.server.WebTestClient;\n\nimport py.com.itti.ms.base.user.application.port.in.command.AuthenticateUserCommand;\nimport py.com.itti.ms.base.user.application.port.in.usecase.AuthenticateUserUseCase;\nimport py.com.itti.ms.base.user.domain.model.AccessToken;\nimport reactor.core.publisher.Mono;\n\n@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)\n@AutoConfigureWebTestClient\n@ActiveProfiles(\"test\")\n@TestPropertySource(properties = {\n    \"spring.cloud.aws.sqs.enabled=false\",\n    \"aws.sqs.listener.enabled=false\",\n    \"cache.type=none\"\n})\n@DisplayName(\"AuthenticationController Tests\")\nclass AuthenticationControllerTest {\n\n    private static final String LOGIN_URI = \"/api/v1/auth/login\";\n\n    @MockitoBean\n    private AuthenticateUserUseCase authenticateUserUseCase;\n\n    @Autowired\n    private WebTestClient webTestClient;\n\n    @Test\n    @DisplayName(\"POST /api/v1/auth/login should return 200 with valid credentials\")\n    void shouldReturn200WhenValidCredentials() {\n        Instant future = Instant.now().plusSeconds(3600);\n        when(authenticateUserUseCase.execute(any(AuthenticateUserCommand.class)))\n                .thenReturn(Mono.just(new AccessToken(\"jwt-token\", future)));\n\n        webTestClient.post()\n                .uri(LOGIN_URI)\n                .contentType(MediaType.APPLICATION_JSON)\n                .bodyValue(\"{\\\"email\\\":\\\"test@example.com\\\",\\\"password\\\":\\\"secret\\\"}\")\n                .exchange()\n                .expectStatus().isOk()\n                .expectBody()\n                .jsonPath(\"$.accessToken\").isEqualTo(\"jwt-token\")\n                .jsonPath(\"$.tokenType\").isEqualTo(\"Bearer\");\n    }\n\n    @Test\n    @DisplayName(\"POST /api/v1/auth/login should return 400 when email is invalid\")\n    void shouldReturn400WhenInvalidEmail() {\n        webTestClient.post()\n                .uri(LOGIN_URI)\n                .contentType(MediaType.APPLICATION_JSON)\n                .bodyValue(\"{\\\"email\\\":\\\"invalid-email\\\",\\\"password\\\":\\\"secret\\\"}\")\n                .exchange()\n                .expectStatus().isBadRequest();\n    }\n\n    @Test\n    @DisplayName(\"POST /api/v1/auth/login should return 400 when email is missing\")\n    void shouldReturn400WhenEmailMissing() {\n        webTestClient.post()\n                .uri(LOGIN_URI)\n                .contentType(MediaType.APPLICATION_JSON)\n                .bodyValue(\"{\\\"password\\\":\\\"secret\\\"}\")\n                .exchange()\n                .expectStatus().isBadRequest();\n    }\n\n    @Test\n    @DisplayName(\"POST /api/v1/auth/login should return 400 when password is missing\")\n    void shouldReturn400WhenPasswordMissing() {\n        webTestClient.post()\n                .uri(LOGIN_URI)\n                .contentType(MediaType.APPLICATION_JSON)\n                .bodyValue(\"{\\\"email\\\":\\\"test@example.com\\\"}\")\n                .exchange()\n                .expectStatus().isBadRequest();\n    }\n\n    @Test\n    @DisplayName(\"POST /api/v1/auth/login should return 400 when body is empty\")\n    void shouldReturn400WhenBodyEmpty() {\n        webTestClient.post()\n                .uri(LOGIN_URI)\n                .contentType(MediaType.APPLICATION_JSON)\n                .bodyValue(\"{}\")\n                .exchange()\n                .expectStatus().isBadRequest();\n    }\n\n    @Test\n    @DisplayName(\"POST /api/v1/auth/login should return 200 with correct expiresAt\")\n    void shouldReturnCorrectExpiresAt() {\n        Instant future = Instant.now().plusSeconds(7200);\n        when(authenticateUserUseCase.execute(any(AuthenticateUserCommand.class)))\n                .thenReturn(Mono.just(new AccessToken(\"jwt-token\", future)));\n\n        webTestClient.post()\n                .uri(LOGIN_URI)\n                .contentType(MediaType.APPLICATION_JSON)\n                .bodyValue(\"{\\\"email\\\":\\\"user@ulab.com\\\",\\\"password\\\":\\\"pass123\\\"}\")\n                .exchange()\n                .expectStatus().isOk()\n                .expectBody()\n                .jsonPath(\"$.accessToken\").isEqualTo(\"jwt-token\")\n                .jsonPath(\"$.tokenType\").isEqualTo(\"Bearer\");\n    }\n}"}Voy a hacer cambios quirúrgicos. Primero agregar el import faltante:


