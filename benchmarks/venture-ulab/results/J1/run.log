       .jsonPath(\"$.message\").isEqualTo(\"PONG\");\n    }\n\n    @Test\n    @DisplayName(\"GET /v1/ping/{name} with special name should return 200\")\n    void shouldReturn200WithSpecialName() {\n        when(baseService.ping(\"hello-world\")).thenReturn(\"PONG hello-world\");\n\n        webTestClient.get()\n                .uri(PING_URI, \"hello-world\")\n                .accept(MediaType.APPLICATION_JSON)\n                .exchange()\n                .expectStatus().isOk()\n                .expectBody()\n                .jsonPath(\"$.message\").isEqualTo(\"PONG hello-world\");\n    }\n}\n"}
