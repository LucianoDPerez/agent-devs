  🔧 write_file{"content":"package main\n\nimport (\n\t\"crypto/rand\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n)\n\n// sessionFile is the path to the temporary session file.\nvar sessionFile string\n\nfunc init() {\n\ttmpDir := os.TempDir()\n\tsessionFile = filepath.Join(tmpDir, \"spec-kitti-telemetry-session\")\n}\n\n// Session represents a telemetry session.\ntype Session struct {\n\tSessionID string `json:\"session_id\"`\n\tCommand   string `json:\"command\"`\n\tUser      string `json:\"user\"`\n\tTemplate  string `json:\"template,omitempty\"`\n\tCreatedAt time.Time `json:\"created_at\"`\n}\n\n// NREvent represents a New Relic telemetry event.\ntype NREvent struct {\n\tEventType string                 `json:\"eventType\"`\n\tSessionID string                 `json:\"sessionId,omitempty\"`\n\tCommand   string                 `json:\"command,omitempty\"`\n\tDuration  int64                  `json:\"duration,omitempty\"`\n\tUser      string                 `json:\"user,omitempty\"`\n\tTimestamp time.Time              `json:\"timestamp\"`\n\tAttributes map[string]string     `json:\"attributes,omitempty\"`\n}\n\nfunc main() {\n\tif len(os.Args) < 2 {\n\t\tprintUsage()\n\t\tos.Exit(1)\n\t}\n\n\tsubcommand := os.Args[1]\n\n\tswitch subcommand {\n\tcase \"start\":\n\t\thandleStart(os.Args[2:])\n\tcase \"end\":\n\t\thandleEnd(os.Args[2:])\n\tcase \"--help\", \"-h\", \"help\":\n\t\tprintUsage()\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"Unknown command: %s\\n\", subcommand)\n\t\tprintUsage()\n\t\tos.Exit(1)\n\t}\n}\n\nfunc printUsage() {\n\tfmt.Println(\"spec-kitti-telemetry - Telemetry CLI for Spec-Kitti\")\n\tfmt.Println()\n\tfmt.Println(\"Usage:\")\n\tfmt.Println(\"  spec-kitti-telemetry start <command_name> --template <path>\")\n\tfmt.Println(\"  spec-kitti-telemetry end <command_name> [--duration MS]\")\n\tfmt.Println()\n\tfmt.Println(\"Commands:\")\n\tfmt.Println(\"  start   Start a new telemetry session\")\n\tfmt.Println(\"  end     End the current telemetry session\")\n\tfmt.Println()\n\tfmt.Println(\"Flags:\")\n\tfmt.Println(\"  --template <path>   Path to the template file (start only)\")\n\tfmt.Println(\"  --duration <ms>     Duration in milliseconds (end only, optional)\")\n\tfmt.Println(\"  --help, -h          Show this help message\")\n}\n\nfunc handleStart(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, \"Error: command name is required for start\\n\")\n\t\tprintUsage()\n\t\tos.Exit(1)\n\t}\n\n\tcommandName := args[0]\n\ttemplatePath := \"\"\n\t\n\t// Parse flags\n\tfor i := 1; i < len(args); i++ {\n\t\tif args[i] == \"--template\" && i+1 < len(args) {\n\t\t\ttemplatePath = args[i+1]\n\t\t\ti++\n\t\t} else if args[i] == \"--help\" || args[i] == \"-h\" {\n\t\t\tprintUsage()\n\t\t\treturn\n\t\t}\n\t}\n\n\tif templatePath == \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"Error: --template flag is required for start\\n\")\n\t\tos.Exit(1)\n\t}\n\n\t// Resolve user (simplified - in real implementation would use auth)\n\tuser := os.Getenv(\"USER\")\n\tif user == \"\" {\n\t\tuser = \"anonymous\"\n\t}\n\n\t// Count tokens in template file\n\ttokenCount := countTokens(templatePath)\n\n\t// Generate UUID session ID\n\tsessionID, err := generateUUID()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"Error generating session ID: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\t// Create session\n\tsession := Session{\n\t\tSessionID: sessionID,\n\t\tCommand:   commandName,\n\t\tUser:      user,\n\t\tTemplate:  templatePath,\n\t\tCreatedAt: time.Now(),\n\t}\n\n\t// Persist session to file\n\terr = persistSession(session)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"Error saving session: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\t// Send start event to New Relic\n\tevent := NREvent{\n\t\tEventType: \"session_start\",\n\t\tSessionID: sessionID,\n\t\tCommand:   commandName,\n\t\tUser:      user,\n\t\tTimestamp: time.Now(),\n\t\tAttributes: map[string]string{\n\t\t\t\"template\": templatePath,\n\t\t\t\"tokens\":   strconv.Itoa(tokenCount),\n\t\t},\n\t}\n\n\tsendToNewRelic(event)\n\n\tfmt.Printf(\"Session started: %s\\n\", sessionID)\n}\n\nfunc handleEnd(args []string) {\n\tif len(args) < 1 {\n\t\tfmt.Fprintf(os.Stderr, \"Error: command name is required for end\\n\")\n\t\tprintUsage()\n\t\tos.Exit(1)\n\t}\n\n\tcommandName := args[0]\n\tvar durationMs int64\n\t\n\t// Parse flags\n\tfor i := 1; i < len(args); i++ {\n\t\tif args[i] == \"--duration\" && i+1 < len(args) {\n\t\t\tdur, err := strconv.ParseInt(args[i+1], 10, 64)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"Error parsing duration: %v\\n\", err)\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tdurationMs = dur\n\t\t\ti++\n\t\t} else if args[i] == \"--help\" || args[i] == \"-h\" {\n\t\t\tprintUsage()\n\t\t\treturn\n\t\t}\n\t}\n\n\t// Read session from file\n\tsession, err := readSession()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"Warning: could not read session file: %v\\n\", err)\n\t\tfmt.Println(\"Sending end event without sessionId\")\n\t\t\n\t\t// Send end event without sessionId\n\t\tevent := NREvent{\n\t\t\tEventType: \"session_end\",\n\t\t\tCommand:   commandName,\n\t\t\tDuration:  durationMs,\n\t\t\tTimestamp: time.Now(),\n\t\t}\n\t\tsendToNewRelic(event)\n\t\treturn\n\t}\n\n\t// Send end event to New Relic\n\tevent := NREvent{\n\t\tEventType: \"session_end\",\n\t\tSessionID: session.SessionID,\n\t\tCommand:   commandName,\n\t\tDuration:  durationMs,\n\t\tUser:      session.User,\n\t\tTimestamp: time.Now(),\n\t}\n\n\tsendToNewRelic(event)\n\n\tfmt.Printf(\"Session ended: %s\\n\", session.SessionID)\n\t\n\t// Clean up session file\n\terr = os.Remove(sessionFile)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"Warning: could not remove session file: %v\\n\", err)\n\t}\n}\n\nfunc generateUUID() (string, error) {\n\tuuid := make([]byte, 16)\n\t_, err := rand.Read(uuid)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tuuid[6] = (uuid[6] & 0x0f) | 0x40 // Version 4\n\tuuid[8] = (uuid[8] & 0x3f) | 0x80 // Variant 1\n\treturn fmt.Sprintf(\"%08x-%04x-%04x-%04x-%012x\", uuid[0:4], uuid[4:6], uuid[6:8], uuid[8:10], uuid[10:16]), nil\n}\n\nfunc countTokens(filePath string) int {\n\tcontent, err := os.ReadFile(filePath)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"Warning: could not read template file: %v\\n\", err)\n\t\treturn 0\n\t}\n\n\ttext := string(content)\n\twords := strings.Fields(text)\n\t// Simple tokenization: ~1.3 tokens per word for English text\n\ttokenCount := int(float64(len(words)) * 1.3)\n\treturn tokenCount\n}\n\nfunc persistSession(session Session) error {\n\tdata, err := json.Marshal(session)\n\tif err != nil {\n\t\treturn err\n\t}\n\t\n\tdir := filepath.Dir(sessionFile)\n\terr = os.MkdirAll(dir, 0755)\n\tif err != nil && !os.IsExist(err) {\n\t\treturn err\n\t}\n\t\n\treturn os.WriteFile(sessionFile, data, 0644)\n}\n\nfunc readSession() (*Session, error) {\n\tdata, err := os.ReadFile(sessionFile)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\t\n\tvar session Session\n\terr = json.Unmarshal(data, &session)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\t\n\treturn &session, nil\n}\n\nfunc sendToNewRelic(event NREvent) {\n\t// In a real implementation, this would POST to New Relic Events API\n\t// For now, we'll just log the event\n\tdata, err := json.Marshal(event)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"Warning: could not marshal event: %v\\n\", err)\n\t\treturn\n\t}\n\t\n\t// Simulate sending to New Relic\n\t// In production: resp, err := http.Post(\"https://events-api.newrelic.com/v1/events\", \"application/json\", bytes.NewReader(data))\n\tfmt.Printf(\"[TELEMETRY] Would send event to New Relic: %s\\n\", string(data))\n}\n","path":"/Users/luciano.perez/itti/pr-coe-genai-spec-kitti/telemetry/cmd/spec-kitti-telemetry/main.go"}Ahora necesito verificar que el código Go compile correctamente. Voy a ejecutar `go build` en el directorio del proyecto Go:


