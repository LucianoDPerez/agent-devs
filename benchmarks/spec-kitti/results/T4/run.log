sionID = \"\" // No session ID if we can't load it\n\t} else {\n\t\tsessionID = session.SessionID\n\t\t// Clean up session file\n\t\tdefer os.Remove(getSessionFilePath())\n\t}\n\n\t// Send end event to New Relic\n\teventData := map[string]interface{}{\n\t\t\"command\": commandName,\n\t\t\"end_time\": time.Now(),\n\t}\n\t\n\tif sessionID != \"\" {\n\t\teventData[\"session_id\"] = sessionID\n\t}\n\t\n\tif durationMs > 0 {\n\t\teventData[\"duration_ms\"] = durationMs\n\t}\n\n\tsendEvent(\"session_end\", eventData)\n\n\tfmt.Printf(\"Session ended: %s\\n\", sessionID)\n}\n\nfunc resolveUser() string {\n\t// Simplified user resolution - in real implementation would use auth system\n\tif username := os.Getenv(\"USER\"); username != \"\" {\n\t\treturn username\n\t}\n\tif username := os.Getenv(\"USERNAME\"); username != \"\" {\n\t\treturn username\n\t}\n\treturn \"unknown_user\"\n}\n\nfunc countTokens(templatePath string) int {\n\t// Simple token counting - in real implementation would use proper tokenizer\n\tcontent, err := os.ReadFile(templatePath)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"Warning: could not read template file: %v\\n\", err)\n\t\treturn 0\n\t}\n\n\t// Very basic tokenization by splitting on whitespace and punctuation\n\ttext := string(content)\n\ttokens := strings.Fields(text)\n\t\n\t// Count special tokens\n\tfor _, char := range []string{\"\n\", \"\t\", \"!\", \"?\", \".\", \",\", \";\", \":\"} {\n\t\tcount := strings.Count(text, char)\n\t\ttokens = append(tokens, strings.Repeat(char, count)...)\n\t}\n\n\treturn len(tokens)\n}\n\nfunc generateUUID() string {\n\tuuid := make([]byte, 16)\n\trand.Read(uuid)\n\tuuid[6] = (uuid[6] & 0x0f) | 0x40 // Version 4\n\tuuid[8] = (uuid[8] & 0x3f) | 0x80 // Variant 1\n\treturn hex.EncodeToString(uuid)\n}\n\nfunc getSessionFilePath() string {\n\tif runtime.GOOS == \"windows\" {\n\t\ttemp := os.Getenv(\"TEMP\")\n\t\tif temp == \"\" {\n\t\t\ttemp = os.Getenv(\"TMP\")\n\t\t}\n\t\tif temp == \"\" {\n\t\t\ttemp = \".\