{
  "name": "ueno-ads-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "ts-node -r tsconfig-paths/register --project apps/api/tsconfig.json apps/api/src/main.ts",
    "dev:mobile-demo": "node scripts/dev-mobile-demo.mjs",
    "dev:mobile-demo:open": "open http://localhost:8765/",
    "dev:ops-html": "python3 -m http.server 3003 --directory ui-html",
    "build": "NODE_ENV=production next build",
    "build:api": "tsc --project apps/api/tsconfig.json && tsc-alias --project apps/api/tsconfig.json",
    "start": "next start",
    "start:api": "node -r ./infra/null/register-paths.cjs -r ./infra/null/compose-env.cjs dist/api/apps/api/src/main.js",
    "start:app": "node ./infra/null/start-app.cjs",
    "lint": "eslint .",
    "check-boundaries": "bash scripts/check-boundaries.sh",
    "healthcheck": "bash scripts/healthcheck.sh && echo 'Healthcheck passed'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:ui": "playwright test",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate -f migrate.config.js up",
    "migrate:down": "node-pg-migrate down",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "migrate:prisma": "prisma migrate deploy",
    "migrate:prisma:dev": "prisma migrate dev",
    "lint:boundaries": "eslint --ext .ts src/modules/ --max-warnings 0",
    "load:capacity": "k6 run tests/load/ad-serving-capacity.js",
    "load:cache-fallback": "bash scripts/run-cache-fallback-test.sh",
    "load:pace": "k6 run tests/load/pace-query.js",
    "load:fire-forget": "k6 run tests/load/fire-forget-loss.js",
    "load:seed-impressions": "ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/seed-impression-events.ts",
    "seed:metricas-historico": "ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/seed-metricas-historico.ts",
    "seed:metricas:snapshot:export": "ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/export-metricas-seed-snapshot.ts",
    "seed:metricas:snapshot:restore": "ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/restore-metricas-seed-snapshot.ts",
    "seed:backfill-export-fields": "ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/backfill-pauta-export-fields.ts",
    "load:bench-pace": "ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/benchmark-pace-query.ts",
    "load:ff-baseline": "ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/measure-fire-forget-loss.ts --baseline",
    "load:ff-finalize": "ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/measure-fire-forget-loss.ts --finalize",
    "seed:operator": "ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/seed-operator.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.19.3",
    "archiver": "^7.0.1",
    "axios": "^1.19.0",
    "cookie-parser": "^1.4.7",
    "lucide-react": "^1.16.0",
    "newrelic": "^13.20.0",
    "next": "15.5.21",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@nestjs/testing": "^11.1.24",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.15.40",
    "@types/archiver": "^6.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.21",
    "node-pg-migrate": "^7.9.1",
    "postcss": "8.5.23",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "3.2.7"
  },
  "overrides": {
    "undici": "7.29.0",
    "form-data": "4.0.6",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "ws": "8.21.1",
    "browserslist": "4.28.7",
    "node-pg-migrate": {
      "glob": "11.1.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "flat-cache": {
      "rimraf": "5.0.10"
    }
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register --project apps/api/tsconfig.json prisma/seed.ts"
  }
}
