  🔧 edit_file{"path":"/Users/luchop/PROYECTOS IA/Medicos/backend/src/interfaces/http/middlewares/validate.ts","new_str":"import { Request, Response, NextFunction } from \"express\";\nimport { ValidationError } from \"../../../domain/errors/AppError\";\n\ntype ValidationRule = {\n  field: string;\n  required?: boolean;\n  minLength?: number;\n  maxLength?: number;\n  pattern?: RegExp;\n  type?: \"array\" | \"number\" | \"string\" | \"boolean\";\n  message?: string;\n};\n\nexport function validate(rules: ValidationRule[]) {\n  return (req: Request, _res: Response, next: NextFunction): void => {\n    for (const rule of rules) {\n      const value = req.body[rule.field];\n\n      if (rule.required && (value === undefined || value === null || value === \"\")) {\n        throw new ValidationError(rule.message || `${rule.field} es requerido`);\n      }\n\n      if (value !== undefined && value !== null && value !== \"\") {\n        // Validar tipo\n        if (rule.type === \"array\" && !Array.isArray(value)) {\n          throw new ValidationError(rule.message || `${rule.field} debe ser un array`);\n        }\n        if (rule.type === \"number\" && typeof value !== \"number\") {\n          throw new ValidationError(rule.message || `${rule.field} debe ser un número`);\n        }\n        if (rule.type === \"string\" && typeof value !== \"string\") {\n          throw new ValidationError(rule.message || `${rule.field} debe ser una cadena`);\n        }\n        if (rule.type === \"boolean\" && typeof value !== \"boolean\") {\n          throw new ValidationError(rule.message || `${rule.field} debe ser un booleano`);\n        }\n\n        // Validar longitud para arrays\n        if (Array.isArray(value)) {\n          if (rule.minLength !== undefined && value.length < rule.minLength) {\n            throw new ValidationError(\n              rule.message || `${rule.field} debe tener al menos ${rule.minLength} elementos`\n            );\n          }\n          if (rule.maxLength !== undefined && value.length > rule.maxLength) {\n            throw new ValidationError(\n              rule.message || `${rule.field} debe tener máximo ${rule.maxLength} elementos`\n            );\n          }\n        }\n\n        // Validar longitud para strings\n        if (typeof value === \"string\") {\n          if (rule.minLength !== undefined && value.length < rule.minLength) {\n            throw new ValidationError(\n              rule.message || `${rule.field} debe tener al menos ${rule.minLength} caracteres`\n            );\n          }\n          if (rule.maxLength !== undefined && value.length > rule.maxLength) {\n            throw new ValidationError(\n              rule.message || `${rule.field} debe tener máximo ${rule.maxLength} caracteres`\n            );\n          }\n        }\n\n        // Validar patrón\n        if (rule.pattern && !rule.pattern.test(String(value))) {\n          throw new ValidationError(rule.message || `${rule.field} tiene formato inválido`);\n        }\n      }\n    }\n    next();\n  };\n}","old_str":"import { Request, Response, NextFunction } from \"express\";\nimport { ValidationError } from \"../../../domain/errors/AppError\";\n\ntype ValidationRule = {\n  field: string;\n  required?: boolean;\n  minLength?: number;\n  maxLength?: number;\n  pattern?: RegExp;\n  message?: string;\n};\n\nexport function validate(rules: ValidationRule[]) {\n  return (req: Request, _res: Response, next: NextFunction): void => {\n    for (const rule of rules) {\n      const value = req.body[rule.field];\n\n      if (rule.required && (value === undefined || value === null || value === \"\")) {\n        throw new ValidationError(rule.message || `${rule.field} es requerido`);\n      }\n\n      if (value !== undefined && value !== null && value !== \"\") {\n        if (rule.minLength !== undefined && String(value).length < rule.minLength) {\n          throw new ValidationError(\n            rule.message || `${rule.field} debe tener al menos ${rule