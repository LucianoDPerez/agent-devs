k if we have enough books to form this group.\n\\t\\t\\tvalid := true\\n\\t\\t\\tfor i := 0; i < size; i++ {\n\\t\\t\\t\tidx := start + i\\n\\t\\t\\t\tif idx > 5 || counts[idx] == 0 {\n\\t\\t\\t\\t\\tvalid = false\\n\\t\\t\\t\\t\\tbreak\\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\tif !valid {\n\\t\\t\\t\\tcontinue\\n\\t\\t\\t}\n\\n\\t\\t\\t// Check if we can form a group of 'size' distinct books.\n\\t\\t\tdistinct := 0\\n\\t\\t\\tfor i := 0; i < size; i++ {\n\\t\\t\\t\tidx := start + i\\n\\t\\t\\t\tif counts[idx] > 0 {\n\\t\\t\\t\\t\tdistinct++\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\tif distinct < size {\n\\t\\t\\t\\tcontinue\\n\\t\\t\\t}\n\\n\\t\\t\\t// Form the group: subtract one copy from each book in the group.\n\\t\\t\\tgroupCounts := make([]int, 6)\n\\t\\t\\tfor i := 0; i < size; i++ {\n\\t\\t\\t\tidx := start + i\\n\\t\\t\\t\\tgroupCounts[idx] = counts[idx] - 1\\n\\t\\t\\t}\n\\n\\t\\t\\t// Calculate the total price for this group.\n\\t\\t\\tgroupTotal := pricePerBook[size]\n\\n\\t\\t\\t// Recurse for the remaining books.\n\\t\\t\\tremainingTotal := recursiveMax(groupCounts, start)\n\\n\\t\\t\ttotal := groupTotal + remainingTotal\\n\\t\\t\tif total > maxTotal {\n\\t\\t\\t\\tmaxTotal = total\\n\\t\\t\\t}\n\\t\\t}\n\\n\\t\\treturn maxTotal\\n\\t}\n\\n\\trecursiveMax(counts, 1)\n\\treturn maxTotal\\n}\"}]"}


