 ValueError(\"Modular inverse does not exist.\")\n        return x % m\n\n    a_inv = modinv(a, m)\n\n    # Filter only letters from ciphertext\n    chars_to_decrypt = []\n    for char in ciphered_text:\n        if char.isalpha():\n            index = ord(char.upper()) - ord('A')\n            decrypted_index = (a_inv * (index - b)) % m\n            chars_to_decrypt.append(alphabet[decrypted_index])\n        # Digits and other characters are ignored (excluded)\n\n    # Group into 5 letters separated by space\n    groups = []\n    for i in range(0, len(chars_to_decrypt), 5):\n        group = chars_to_decrypt[i:i + 5]\n        groups.append(\" \".join(group))\n\n    return \" \".join(groups)"}
