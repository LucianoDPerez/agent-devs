  🔧 write_file{"path":"/tmp/poly225/GO03/book-store/book_store.go","content":"package bookstore\n\n// Calculate the total price of a shopping basket of books, applying the\n// maximum possible discount. Each book costs $8. Discounts are applied to\n// groups of different books: 2 different books -> 5%, 3 -> 10%, 4 -> 20%,\n// 5 -> 25%. The goal is to partition the basket into groups to maximize the\n// total discount.\nfunc Cost(books []int) int {\n\t// Count the number of copies of each book (1-5).\n\tcounts := make([]int, 6) // index 0 unused, 1-5 for the five books\n\tfor _, book := range books {\n\t\tif book >= 1 && book <= 5 {\n\t\t\tcounts[book]++\n\t\t}\n\t}\n\n\t// Precompute the price per book for each possible group size (1-5).\n\tpricePerBook := make([]int, 6)\n\tfor size := 1; size <= 5; size++ {\n\t\tdiscount := 0\n\t\tswitch size {\n\t\tcase 1:\n\t\t\tdiscount = 0\n\t\tcase 2:\n\t\t\tdiscount = 5\n\t\tcase 3:\n\t\t\tdiscount = 10\n\t\tcase 4:\n\t\t\tdiscount = 20\n\t\tcase 5:\n\t\t\tdiscount = 25\n\t\t}\n\t\tpricePerBook[size] = 8000 - (8000 * discount) / 100\n\t}\n\n\t// Try all possible ways to partition the counts into groups to find the\n\t// maximum total price (minimum discount). We use a recursive approach\n\t// that explores all valid partitions.\n\tmaxTotal := 0\n\trecursiveMax := func(counts []int, start int) int {\n\t\t// Base case: all books are accounted for.\n\t\tif start > 5 {\n\t\t\treturn 0\n\t\t}\n\n\t\t// If no books left for this start index, move to next.\n\t\tif counts[start] == 0 {\n\t\t\treturn recursiveMax(counts, start+1)\n\t\t}\n\n\t\t// Try forming a group of size 1 (single book).\n\t\ttotal1 := 8000 + recursiveMax(counts, start+1)\n\t\tif total1 > maxTotal {\n\t\t\tmaxTotal = total1\n\t\t}\n\n\t\t// Try forming groups of size 2 to 5 starting at 'start'.\n\t\tfor size := 2; size <= 5; size++ {\n\t\t\t// Check if we have enough books to form this group.\n\t\t\tvalid := true\n\t\t\tfor i := 0; i < size; i++ {\n\t\t\t\tidx := start + i\n\t\t\t\tif idx > 5 || counts[idx] == 0 {\n\t\t\t\t\tvalid = false\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif !valid {\n\t\t\t\tcontinue\n\t\t\t}\n\n\t\t\t// Check if we can form a group of 'size' distinct books.\n\t\t\tdistinct := 0\n\t\t\tfor i := 0; i < size; i++ {\n\t\t\t\tidx := start + i\n\t\t\t\tif counts[idx] > 0 {\n\t\t\t\t\tdistinct++\n\t\t\t\t}\n\t\t\t}\n\t\t\tif distinct < size {\n\t\t\t\tcontinue\n\t\t\t}\n\n\t\t\t// Form the group: subtract one copy from each book in the group.\n\t\t\tgroupCounts := make([]int, 6)\n\t\t\tfor i := 0; i < size; i++ {\n\t\t\t\tidx := start + i\n\t\t\t\tgroupCounts[idx] = counts[idx] - 1\n\t\t\t}\n\n\t\t\t// Calculate the total price for this group.\n\t\t\tgroupTotal := pricePerBook[size]\n\n\t\t\t// Recurse for the remaining books.\n\t\t\tremainingTotal := recursiveMax(groupCounts, start)\n\n\t\t\ttotal := groupTotal + remainingTotal\n\t\t\tif total > maxTotal {\n\t\t\t\tmaxTotal = total\n\t\t\t}\n\t\t}\n\n\t\treturn maxTotal\n\t}\n\n\trecursiveMax(counts, 1)\n\treturn maxTotal\n}\n"}
