  🔧 edit_file{"path":"/tmp/poly225/CP05/circular-buffer/circular_buffer.cpp","old_str":"#include \"circular_buffer.h\"\n\nnamespace circular_buffer {\n\n}  // namespace circular_buffer","new_str":"#include \"circular_buffer.h\"\n\nnamespace circular_buffer {\n\ncircular_buffer::circular_buffer(std::size_t capacity)\n    : capacity_(capacity),\n      size_(0),\n      start_(0),\n      end_(0)\n{\n    if (capacity == 0) {\n        throw std::domain_error(\"circular_buffer capacity must be greater than 0\");\n    }\n    buffer_.resize(capacity);\n}\n\nvoid circular_buffer::write(const T& value)\n{\n    if (size_ >= capacity_) {\n        throw std::domain_error(\"circular_buffer is full\");\n    }\n\n    end_ = (end_ + 1) % capacity_;\n    buffer_[end_] = value;\n    size_++;\n}\n\nT circular_buffer::read()\n{\n    if (size_ == 0) {\n        throw std::domain_error(\"circular_buffer is empty\");\n    }\n\n    T value = buffer_[start_];\n    start_ = (start_ + 1) % capacity_;\n    size_--;\n    return value;\n}\n\nvoid circular_buffer::clear()\n{\n    size_ = 0;\n    start_ = 0;\n    end_ = 0;\n}\n\nvoid circular_buffer::overwrite(const T& value)\n{\n    write(value);\n}\n\nT& circular_buffer::front()\n{\n    return buffer_[start_];\n}\n\nT& circular_buffer::back()\n{\n    return buffer_[end_];\n}\n\nconst T& circular_buffer::front() const\n{\n    return buffer_[start_];\n}\n\nconst T& circular_buffer::back() const\n{\n    return buffer_[end_];\n}\n\n}  // namespace circular_buffer"}
