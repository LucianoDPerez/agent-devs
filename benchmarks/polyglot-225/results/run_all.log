rivate List<Character> toChar(String toChar) {\n        return toChar.chars()\n                .mapToObj(c -> (char) c)\n                .collect(Collectors.toList());\n    }\n\\n    private class AlphameticsRecursion {\n        private final List<Character> characters;\n        private LinkedHashMap<Character, Integer> validPermutation;\n\\n        private AlphameticsRecursion(List<Character> characters) {\n            this.characters = characters;\n        }\n\\n        private void generate() {\n            generate(new LinkedHashMap<>(), 0, new boolean[10]);\n        }\n\\n        private void generate(LinkedHashMap<Character, Integer> permutation, int index, boolean[] isDigitsUsed) {\n            // base case\\n            if (index == characters.size()) {\n                if (!isLeadingDigitZero(permutation) && isSumTally(permutation)) {\n                    validPermutation = new LinkedHashMap<>(permutation);\n                }\n                return;\n            }\n\\n            for (int i = 0; i <= 9; i++) { // loop through digits 0 to 9\\n                if (isDigitsUsed[i]) {\n                    continue;\n                }\n\\n                permutation.put(characters.get(index), i);\n                isDigitsUsed[i] = true;\n                generate(permutation, index + 1, isDigitsUsed);\n                isDigitsUsed[i] = false;\n            }\n        }\n\\n        private Optional<LinkedHashMap<Character, Integer>> get() {\n            return Optional.ofNullable(validPermutation);\n        }\n\\n        /**\n         * Returns true if the mapping letters to digits using {@code letterToDigit} will result in having zero as a\\n         * leading digit.\n         */\n        private boolean isLeadingDigitZero(Map<Character, Integer> letterToDigit) {\n            return letterToDigit.keySet().stream()\n                    .filter(key -> letterToDigit.get(key) == 0) // Find the character that is mapped to digit 0\\n                    .filter(charMappe