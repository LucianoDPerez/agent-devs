Implementaré el código ahora:

```cpp
#include "all_your_base.h"

#include <stdexcept>
#include <vector>

namespace all_your_base {

bool is_valid_base(int base) {
    return base > 0 && base <= 36;
}

bool is_valid_digit(unsigned int digit, int base) {
    return digit < base;
}

vector<unsigned int> convert(int from_base, const std::vector<unsigned int>& in_digits, int to_base) {
    if (!is_valid_base(from_base) || !is_valid_base(to_base)) {
        throw std::invalid_argument("Invalid base");
    }

    if (from_base == to_base) {
        return in_digits;
    }

    // Convert from the source base to an intermediate value (unsigned long long)
    unsigned long long value = 0;
    for (unsigned int digit : in_digits) {
        if (!is_valid_digit(digit, from_base)) {
            throw std::invalid_argument("Invalid digit in source base");
        }
        value = value * static_cast<unsigned long long>(from_base) + static_cast<unsigned long long>(digit);
    }

    // Convert from the intermediate value to the target base
    vector<unsigned int> out_digits;
    if (value == 0) {
        out_digits.push_back(0);
    } else {
        while (value > 0) {
            unsigned int remainder = static_cast<unsigned int>(value % static_cast<unsigned long long>(to_base));
            out_digits.push_back(remainder);
            value /= static_cast<unsigned long long>(to_base);
        }
    }

    return out_digits;
}

} // namespace all_your_base
```

