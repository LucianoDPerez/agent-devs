t\\tbreak\\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\tif first == -1 {\n\\t\\t\\t\\tbreak\\n\\t\\t\\t}\n\\n\\t\\t\\t// Try to form a group of `size` different books.\n\\t\\t\\tgroup := make([]int, 0, size)\n\\t\\t\\tvalid := true\\n\\t\\t\\tfor i := 1; i <= 5; i++ {\n\\t\\t\\t\tif counts[i] > 0 {\n\\t\\t\\t\\t\\tgroup = append(group, i)\n\\t\\t\\t\\t\\tcounts[i]--\n\\t\\t\\t\\t}\n\\t\\t\\t}\n\\t\\t\\t// If we couldn't fill the group with distinct books,\n\\t\\t\\t// undo the decrements and try again.\n\\t\\t\tif len(group) < size {\n\\t\\t\\t\\t// Undo the decrements.\n\\t\\t\\t\\tfor _, book := range group {\n\\t\\t\\t\\t\\tcounts[book]++\n\\t\\t\\t\\t}\n\\t\\t\\t\\tgroup = nil\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\t}\n\\t\\t\tgroups = append(groups, size)\n\\t\\t\\tbreak\\n\\t\\t}\n\\t}\n\\n\\t// Any remaining copies (less than 2) are sold at full price.\n\\tremaining := 0\\n\\tfor _, book := range books {\n\\t\tif book >= 1 && book <= 5 {\n\\t\\t\\tremaining += counts[book]\n\\t\\t}\n\\t}\n\\n\ttotal := 0\\n\\tfor _, size := range groups {\n\\t\tdiscount := discountForCount(size)\n\\t\\tpricePerBook := 800 - discount\\n\\t\ttotal += size * pricePerBook\\n\\t}\n\\tfor i := 0; i < remaining; i++ {\n\\t\ttotal += 800\\n\\t}\n\\n\\treturn total\\n}\"}]"}
