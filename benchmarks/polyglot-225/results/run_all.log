  🔧 apply_patch{"path":"/tmp/poly225/JS02/alphametics/alphametics.js","edits":"[{\"old_string\": \"//\n// This is only a SKELETON file for the 'Alphametics' exercise. It's been provided as a\\n// convenience to get you started writing code faster.\n//\n\nexport const solve = () => {\n  throw new Error('Remove this statement and implement this function');\n};\", \"new_string\": \"//\n// This is only a SKELETON file for the 'Alphametics' exercise. It's been provided as a\\n// convenience to get you started writing code faster.\n//\n\\n/**\n * Solves an alphametics puzzle.\n *\n * @param {string} puzzle - The puzzle string, e.g. 'SEND + MORE == MONEY'.\n * @returns {Object<string, number> | null} - A mapping of letters to digits,\n *   or null if no valid solution exists.\n */\nexport const solve = (puzzle) => {\n  // Parse the puzzle into left and right sides.\n  const eqIndex = puzzle.indexOf('==');\n  if (eqIndex === -1) {\n    return null;\n  }\n\\n  const leftStr = puzzle.substring(0, eqIndex).trim();\n  const rightStr = puzzle.substring(eqIndex + 2).trim();\n\\n  // Split each side into addends and the total.\n  const leftAddends = leftStr.split(' + ').map((s) => s.trim());\n  const rightTotal = rightStr.trim();\n\\n  // Extract all unique letters from the puzzle.\n  const letters = new Set();\n  for (const side of [leftStr, rightStr]) {\n    for (const char of side) {\n      if (char !== ' ' && char !== '+' && char !== '=' && char !== '-') {\n        letters.add(char);\n      }\n    }\n  }\n\\n  const lettersArray = Array.from(letters);\n  const letterCount = lettersArray.length;\n\\n  // If there are more letters than digits, no solution is possible.\n  if (letterCount > 10) {\n    return null;\n  }\n\\n  // Try all possible digit assignments using a recursive backtracking approach.\n  const digits = Array.from({ length: 10 }, (_, i) => i);\n  const usedDigits = new Set();\n  const letterToDigit = {};\n\\n  const isLeadingZero = (word) => {\n    if (word.length === 0) return false;\n    const firstChar = word[0];\n    return letterToDigit[firstChar] === 0;\n  };\n\\n  const evaluateWord = (word) => {\n    let value = 0;\n    for (const char of word) {\n      value = value * 10 + letterToDigit[char];\n    }\n    return value;\n  };\n\\n  const backtrack = (index) => {\n    if (index === letterCount) {\n      // All letters have been assigned. Verify the sum.\n      let total = 0;\n      for (const addend of leftAddends) {\n        total += evaluateWord(addend);\n      }\n      if (total === evaluateWord(rightTotal)) {\n        return letterToDigit;\n      }\n      return null;\n    }\n\\n    const letter = lettersArray[index];\n    for (let digit of digits) {\n      if (usedDigits.has(digit)) continue;\n\\n      // Skip leading zero for multi-character words.\n      const wordWithLetter = lettersArray.map((l) => l === letter ? letter : l).join('');\n      if (wordWithLetter.length > 1 && digit === 0) continue;\n\\n      usedDigits.add(digit);\n      letterToDigit[letter] = digit;\n\\n      const result = backtrack(index + 1);\n      if (result !== null) {\n        return result;\n      }\n\\n      usedDigits.delete(digit);\n      delete letterToDigit[letter];\n    }\n\\n    return null;\n  };\n\\n  return backtrack(0);\n};\"}]"}
