  🔧 edit_file{"path":"/tmp/poly225/GO03/book-store/book_store.go","old_str":"package bookstore\n\nfunc Cost(books []int) int {\n\tpanic(\"Please implement the Cost function\")\n}","new_str":"package bookstore\n\n// discountForCount returns the discount percentage for a group of n\n// different books. A single book or an empty basket gets no discount.\nfunc discountForCount(n int) int {\n\tif n <= 1 {\n\t\treturn 0\n\t}\n\tswitch n {\n\tcase 2:\n\t\treturn 5\n\tcase 3:\n\t\treturn 10\n\tcase 4:\n\t\treturn 20\n\tcase 5:\n\t\treturn 25\n\tdefault:\n\t\treturn 0\n\t}\n}\n\n// Cost calculates the total price of a shopping basket.\n//\n// The basket is a list of book copies (1..5). The price is maximized\n// by grouping books into sets of different titles whenever possible,\n// applying the largest applicable discount to each set.\nfunc Cost(books []int) int {\n\t// Count how many copies of each book are in the basket.\n\tcounts := make([]int, 6) // indices 1..5\n\tfor _, book := range books {\n\t\tif book >= 1 && book <= 5 {\n\t\t\tcounts[book]++\n\t\t}\n\t}\n\n\t// Greedily form groups of different titles, starting with the\n\t// largest possible group size (5) down to 2.\n\tgroups := make([]int, 0)\n\tfor size := 5; size >= 2; size-- {\n\t\tfor {\n\t\t\t// Find the first book that still has copies left.\n\t\t\tfirst := -1\n\t\t\tfor i := 1; i <= 5; i++ {\n\t\t\t\tif counts[i] > 0 {\n\t\t\t\t\tfirst = i\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t\tif first == -1 {\n\t\t\t\tbreak\n\t\t\t}\n\n\t\t\t// Try to form a group of `size` different books.\n\t\t\tgroup := make([]int, 0, size)\n\t\t\tvalid := true\n\t\t\tfor i := 1; i <= 5; i++ {\n\t\t\t\tif counts[i] > 0 {\n\t\t\t\t\tgroup = append(group, i)\n\t\t\t\t\tcounts[i]--\n\t\t\t\t}\n\t\t\t}\n\t\t\t// If we couldn't fill the group with distinct books,\n\t\t\t// undo the decrements and try again.\n\t\t\tif len(group) < size {\n\t\t\t\t// Undo the decrements.\n\t\t\t\tfor _, book := range group {\n\t\t\t\t\tcounts[book]++\n\t\t\t\t}\n\t\t\t\tgroup = nil\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tgroups = append(groups, size)\n\t\t\tbreak\n\t\t}\n\t}\n\n\t// Any remaining copies (less than 2) are sold at full price.\n\tremaining := 0\n\tfor _, book := range books {\n\t\tif book >= 1 && book <= 5 {\n\t\t\tremaining += counts[book]\n\t\t}\n\t}\n\n\ttotal := 0\n\tfor _, size := range groups {\n\t\tdiscount := discountForCount(size)\n\t\tpricePerBook := 800 - discount\n\t\ttotal += size * pricePerBook\n\t}\n\tfor i := 0; i < remaining; i++ {\n\t\ttotal += 800\n\t}\n\n\treturn total\n}"}
