  🔧 write_file{"path":"/tmp/poly225/PY03/book-store/book_store.py","content":"def total(basket):\n    \"\"\"\n    Calcula el precio total de un carrito de libros, maximizando el descuento\n    según las reglas del bookshop.\n    \"\"\"\n    # Precio base de un libro\n    PRICE_PER_BOOK = 800\n    # Descuentos por porcentaje (en unidades de 100)\n    DISCOUNTS = {\n        5: 25,  # 25%\n        4: 20,  # 20%\n        3: 10,  # 10%\n        2: 5,   # 5%\n        1: 0,   # 0%\n    }\n\n    total_price = 0\n    remaining_books = list(basket)\n\n    # Primero, intentamos formar grupos de 5 (máximo descuento)\n    while len(remaining_books) >= 5:\n        group_of_5 = remaining_books[:5]\n        remaining_books = remaining_books[5:]\n        discount_percent = DISCOUNTS[5]\n        # Precio de un libro con descuento: 800 * (1 - discount_percent/100)\n        price_per_book_discounted = PRICE_PER_BOOK * (1 - discount_percent / 100)\n        total_price += len(group_of_5) * price_per_book_discounted\n\n    # Luego, grupos de 4 (20% descuento)\n    while len(remaining_books) >= 4:\n        group_of_4 = remaining_books[:4]\n        remaining_books = remaining_books[4:]\n        discount_percent = DISCOUNTS[4]\n        price_per_book_discounted = PRICE_PER_BOOK * (1 - discount_percent / 100)\n        total_price += len(group_of_4) * price_per_book_discounted\n\n    # Luego, grupos de 3 (10% descuento)\n    while len(remaining_books) >= 3:\n        group_of_3 = remaining_books[:3]\n        remaining_books = remaining_books[3:]\n        discount_percent = DISCOUNTS[3]\n        price_per_book_discounted = PRICE_PER_BOOK * (1 - discount_percent / 100)\n        total_price += len(group_of_3) * price_per_book_discounted\n\n    # Luego, grupos de 2 (5% descuento)\n    while len(remaining_books) >= 2:\n        group_of_2 = remaining_books[:2]\n        remaining_books = remaining_books[2:]\n        discount_percent = DISCOUNTS[2]\n        price_per_book_discounted = PRICE_PER_BOOK * (1 - discount_percent / 100)\n        total_price += len(group_of_2) * price_per_book_discounted\n\n    # Libros restantes (1 por grupo) sin descuento\n    while remaining_books:\n        book = remaining_books.pop(0)\n        total_price += PRICE_PER_BOOK\n\n    return total_price\n"}
